{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberforge.dev/schemas/applicability.schema.json",
  "title": "Scope & Applicability Determination (Evidence Pack Part B / Part 0.4)",
  "description": "Schema for the machine-validated scope & applicability determination mandated by the Evidence Pack master spec Part B (B.1 entity classification; B.2 system/data inventory + residency; B.3 regulatory applicability matrix with rationale) and struktura Part 0.4 'Oświadczenie o stosowalności'. Closes spec §8 anti-pattern #10 (scope hand-waving). Structural completeness is BLOCKING (validated by scripts/validators/applicability.py); the correspondence of the determination to the entity's real legal position is an EVIDENCE-ONLY human attestation by the named accountable officer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entity",
    "determination",
    "regimes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "entity": {
      "type": "object",
      "description": "B.1 entity classification — the subject of the determination.",
      "additionalProperties": true,
      "required": ["legal_name", "size_class", "role_in_supply_chain"],
      "properties": {
        "legal_name": { "type": "string", "minLength": 1 },
        "registered_office": { "type": "string", "minLength": 1 },
        "identifiers": { "type": "object" },
        "size_class": { "type": "string", "minLength": 1 },
        "sector": { "type": "string", "minLength": 1 },
        "role_in_supply_chain": { "type": "string", "minLength": 1 },
        "primary_markets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "determination": {
      "type": "object",
      "description": "Ownership + freshness metadata for the determination (DORA 5(2)/(3); NIS2 Art.20).",
      "additionalProperties": true,
      "required": ["approved_by", "approver_role", "determination_date", "review_cadence_days"],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "approver_role": { "type": "string", "minLength": 1 },
        "determination_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "review_cadence_days": { "type": "integer", "minimum": 1 },
        "next_review_due": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "status": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "regimes": {
      "type": "object",
      "description": "B.3 regulatory applicability matrix — one block per regime. The spec demands DORA, NIS2-KSC, CRA and RODO are each determined with a rationale.",
      "minProperties": 1,
      "required": ["DORA", "NIS2-KSC", "CRA", "RODO"],
      "additionalProperties": {
        "$ref": "#/$defs/regime"
      }
    },
    "data_flow_residency_ref": {
      "type": "object",
      "description": "B.2 cross-reference to the single-source data-flow/residency map (T-31). Not duplicated here.",
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "rendered_artifact": { "type": "string" },
        "residency_summary": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "boundary_notes": { "type": "string" }
  },
  "$defs": {
    "regime": {
      "type": "object",
      "description": "A single regime's applicability determination. `applies` and a non-empty `rationale` are mandatory (T-120 DoD); a clause/legal basis is required for an auditable determination.",
      "additionalProperties": true,
      "required": ["name", "applies", "rationale", "clause_basis", "legal_basis"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "applies": { "type": "boolean" },
        "applies_as": { "type": "string" },
        "rationale": { "type": "string", "minLength": 1 },
        "clause_basis": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "legal_basis": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "competent_authority": { "type": "string" },
        "obligations_when_applicable": { "type": "string" },
        "transition_notes": { "type": "string" },
        "verification": { "type": "string" }
      }
    }
  }
}
